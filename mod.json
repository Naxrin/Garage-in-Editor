{
	"geode": "6.0.0",
	"gd": {
		"win":"2.2091",
		"android":"2.2091",
		"mac":"2.2091",
		"ios":"2.2091"
	},
	"version": "v5.3.7",
	"id": "naxrin.garage_in_editor",
	"name": "More Garage Ropes",
	"developer": "Naxrin",
	"description": "The tiny QoL mod with extra garage entries",
	"tags": ["interface", "offline"],
	"links": {
		"source": "https://github.com/Naxrin/Garage-in-Editor"
	},
	"dependencies": {
		"geode.node-ids": {
			"version": "v1.24.0-beta.1",
			"required": true
		}
	},
	"settings":{
		"offset": {
            "name": "Placement Offset",
            "description": "Move the added Button left or right if you want.",
            "type": "float",
            "default": 0,
			"min":-10,
			"max":10,
			"control": {
				"slider": true,
				"slider-step": 0.1
			}
        },
		"official": {
            "name": "Official Levels Browser",
            "description": "Add to Official Levels Browser (LevelSelectLayer)",
            "type": "bool",
            "default": true
        },
		"editor": {
			"name": "Editor Garage",
			"description": "Add the garage button to the editor.",
			"type": "bool",
			"default": true
		},
		"hide-vanilla": {
			"name": "Hide Vanilla Garage",
			"description": "Hide the original garage button in level entrance.",
			"type": "bool",
			"default": false
		}
	}
}